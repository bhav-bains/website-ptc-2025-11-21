---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import {
    Package,
    Phone,
    CheckCircle,
    MapPin,
    MessageCircle,
    Shield,
    Monitor,
    Users,
    Zap,
} from "lucide-react";

interface Props {
    // Page Metadata
    title: string;
    description: string;

    // Hero Data
    heroImage: string;
    heroTitle: string;
    heroSubtitle: string;
    heroIcon?: any; // Icon component
    heroIconText?: string;

    // Breadcrumbs
    breadcrumbs: { name: string; url: string }[];

    // Service Options ID
    serviceOptionsTitle: string;
    serviceOptionsDescription: string;
    serviceOptions: {
        icon: any;
        title: string;
        description: string;
        bgColor: string;
        iconColor: string;
        badge: string;
        badgeColor: string;
        image: string;
    }[];

    // Features / Why Choose Us
    featuresTitle: string;
    featuresDescription: string;
    features: {
        icon: any;
        title: string;
        description: string;
    }[];

    // Introduction / Narrative Section
    introImage: string;
    introTitle: string;
    introText: string; // HTML string or plain text
    introSubPoints: {
        icon: any;
        text: string;
    }[];
}

const {
    title,
    description,
    heroImage,
    heroTitle,
    heroSubtitle,
    heroIcon: HeroIcon = Package,
    heroIconText = "Service",
    breadcrumbs,
    serviceOptionsTitle,
    serviceOptionsDescription,
    serviceOptions,
    featuresTitle,
    featuresDescription,
    features,
    introImage,
    introTitle,
    introText,
    introSubPoints,
} = Astro.props;

// JSON-LD Breadcrumb Schema
const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: `https://personaltouchcourier.com${crumb.url}`,
    })),
};
---

<Layout title={title} description={description}>
    <Header />

    <main>
        <!-- Hero Section -->
        <Section
            container={false}
            class="relative min-h-[70vh] flex items-center justify-center overflow-hidden p-0"
        >
            <div class="absolute inset-0 z-0">
                <div class="absolute inset-0 bg-black/60 z-10"></div>
                <div class="absolute inset-0 backdrop-blur-sm z-10"></div>
                <img
                    src={heroImage}
                    alt={`${title} - Personal Touch Courier`}
                    class="w-full h-full object-cover scale-105 blur-[2px]"
                />
            </div>

            <div
                class="relative z-20 text-center max-w-5xl mx-auto px-4 pt-24 pb-12"
            >
                <!-- Breadcrumbs -->
                <nav aria-label="Breadcrumb" class="flex justify-center mb-8">
                    <ol
                        class="flex items-center gap-2 text-xs text-gray-400"
                        itemscope
                        itemtype="https://schema.org/BreadcrumbList"
                    >
                        {
                            breadcrumbs.map((crumb, index) => (
                                <li
                                    class="flex items-center gap-2"
                                    itemprop="itemListElement"
                                    itemscope
                                    itemtype="https://schema.org/ListItem"
                                >
                                    {index > 0 && (
                                        <span class="text-gray-500 text-[10px]">
                                            &gt;
                                        </span>
                                    )}
                                    <a
                                        href={crumb.url}
                                        class={`hover:text-white transition-colors ${index === breadcrumbs.length - 1 ? "text-white cursor-default pointer-events-none" : ""}`}
                                        itemprop="item"
                                    >
                                        <span itemprop="name">
                                            {crumb.name}
                                        </span>
                                    </a>
                                    <meta
                                        itemprop="position"
                                        content={(index + 1).toString()}
                                    />
                                </li>
                            ))
                        }
                    </ol>
                </nav>

                <div
                    class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 mb-6"
                >
                    <HeroIcon class="w-5 h-5 text-white" />
                    <span class="text-white font-medium">{heroIconText}</span>
                </div>

                <h1
                    class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-barlow font-bold text-white mb-6 leading-tight"
                >
                    {heroTitle}
                </h1>
                <p
                    class="text-xl sm:text-2xl text-gray-100 mb-10 max-w-3xl mx-auto leading-relaxed"
                >
                    {heroSubtitle}
                </p>

                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <Button href="#contact" variant="white" size="lg">
                        Request a Quote Now
                    </Button>
                    <Button href="tel:613-723-5891" variant="glass" size="lg">
                        <Phone class="w-5 h-5 mr-2" /> Call Our Dispatch Team
                    </Button>
                </div>
            </div>
        </Section>

        <!-- Trusted Industries Section (Static for now, can be prop-ified later if needed) -->
        <Section background="white" class="py-16">
            <div class="text-center mb-12">
                <h2
                    class="text-2xl sm:text-3xl font-barlow font-bold text-ptc-blue"
                >
                    Our same-day courier service is trusted by businesses across
                    Ottawa.
                </h2>
            </div>
            <div class="flex flex-wrap justify-center gap-8 md:gap-12">
                <div class="flex flex-col items-center gap-3 group">
                    <div
                        class="w-20 h-20 bg-ptc-beige rounded-full flex items-center justify-center shadow-sm group-hover:shadow-lg group-hover:bg-ptc-green transition-all duration-300"
                    >
                        <span
                            class="text-3xl group-hover:scale-110 transition-transform duration-300"
                            >⚖️</span
                        >
                    </div>
                    <span class="font-bold text-gray-900">Legal Firms</span>
                </div>
                <div class="flex flex-col items-center gap-3 group">
                    <div
                        class="w-20 h-20 bg-ptc-beige rounded-full flex items-center justify-center shadow-sm group-hover:shadow-lg group-hover:bg-ptc-green transition-all duration-300"
                    >
                        <span
                            class="text-3xl group-hover:scale-110 transition-transform duration-300"
                            >🏥</span
                        >
                    </div>
                    <span class="font-bold text-gray-900">Medical Offices</span>
                </div>
                <div class="flex flex-col items-center gap-3 group">
                    <div
                        class="w-20 h-20 bg-ptc-beige rounded-full flex items-center justify-center shadow-sm group-hover:shadow-lg group-hover:bg-ptc-green transition-all duration-300"
                    >
                        <span
                            class="text-3xl group-hover:scale-110 transition-transform duration-300"
                            >🏪</span
                        >
                    </div>
                    <span class="font-bold text-gray-900">Retailers</span>
                </div>
                <div class="flex flex-col items-center gap-3 group">
                    <div
                        class="w-20 h-20 bg-ptc-beige rounded-full flex items-center justify-center shadow-sm group-hover:shadow-lg group-hover:bg-ptc-green transition-all duration-300"
                    >
                        <span
                            class="text-3xl group-hover:scale-110 transition-transform duration-300"
                            >🏢</span
                        >
                    </div>
                    <span class="font-bold text-gray-900"
                        >Corporate Offices</span
                    >
                </div>
                <div class="flex flex-col items-center gap-3 group">
                    <div
                        class="w-20 h-20 bg-ptc-beige rounded-full flex items-center justify-center shadow-sm group-hover:shadow-lg group-hover:bg-ptc-green transition-all duration-300"
                    >
                        <span
                            class="text-3xl group-hover:scale-110 transition-transform duration-300"
                            >🏛️</span
                        >
                    </div>
                    <span class="font-bold text-gray-900">Government</span>
                </div>
            </div>
        </Section>

        <!-- JSON-LD Breadcrumb Schema -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(breadcrumbSchema)}
        />

        <!-- Service Options Section -->
        <Section background="gray" class="py-24">
            <div class="text-center mb-16">
                <h2
                    class="text-3xl sm:text-4xl lg:text-5xl font-barlow font-bold text-ptc-blue mb-6"
                >
                    {serviceOptionsTitle}
                </h2>
                <p class="text-lg text-gray-600 max-w-3xl mx-auto">
                    {serviceOptionsDescription}
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                {
                    serviceOptions.map((option) => {
                        const Icon = option.icon;
                        return (
                            <div class="relative bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 group overflow-hidden flex flex-col">
                                <div class="relative h-48 overflow-hidden">
                                    <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors z-10" />
                                    <img
                                        src={option.image}
                                        alt={option.title}
                                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                    />
                                    <div
                                        class={`absolute top-4 right-4 z-20 ${option.badgeColor} text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm`}
                                    >
                                        {option.badge}
                                    </div>
                                </div>
                                <div class="p-8 flex-1 flex flex-col">
                                    <div
                                        class={`p-4 ${option.bgColor} rounded-xl w-fit mb-6`}
                                    >
                                        <Icon
                                            class={`w-8 h-8 ${option.iconColor}`}
                                            strokeWidth={2}
                                        />
                                    </div>
                                    <h3 class="text-2xl font-barlow font-bold text-gray-900 mb-4 group-hover:text-ptc-green transition-colors">
                                        {option.title}
                                    </h3>
                                    <p class="text-gray-600 leading-relaxed">
                                        {option.description}
                                    </p>
                                </div>
                            </div>
                        );
                    })
                }
            </div>
        </Section>

        <!-- Why Choose Us Section -->
        <Section background="white" class="py-24">
            <div class="text-center mb-16">
                <h2
                    class="text-3xl sm:text-4xl lg:text-5xl font-barlow font-bold text-ptc-blue mb-6"
                >
                    {featuresTitle}
                </h2>
                <p class="text-lg text-gray-600 max-w-3xl mx-auto">
                    {featuresDescription}
                </p>
            </div>

            <div class="grid lg:grid-cols-2 gap-6">
                {
                    features.map((feature, index) => {
                        const Icon = feature.icon;
                        return (
                            <div
                                class={`bg-ptc-beige/50 rounded-2xl p-8 hover:bg-ptc-beige transition-colors duration-300 ${index === features.length - 1 ? "lg:col-span-2 lg:max-w-2xl lg:mx-auto" : ""}`}
                            >
                                <div class="flex items-start gap-5">
                                    <div class="shrink-0 p-3 bg-ptc-green/10 rounded-xl">
                                        <Icon
                                            class="w-7 h-7 text-ptc-green"
                                            strokeWidth={2}
                                        />
                                    </div>
                                    <div>
                                        <h3 class="text-xl font-barlow font-bold text-gray-900 mb-3">
                                            {feature.title}
                                        </h3>
                                        <p class="text-gray-600 leading-relaxed">
                                            {feature.description}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        );
                    })
                }
            </div>
        </Section>

        <!-- Use Cases / Narrative Section -->
        <Section background="gray" class="py-24">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div class="relative">
                    <div
                        class="absolute inset-0 bg-ptc-green/10 rounded-3xl transform rotate-3 scale-105 z-0"
                    >
                    </div>
                    <img
                        src={introImage}
                        alt={introTitle}
                        class="relative z-10 rounded-2xl shadow-xl w-full object-cover h-[500px]"
                    />
                </div>

                <div class="prose prose-lg max-w-none text-gray-600">
                    <h2
                        class="text-3xl sm:text-4xl font-barlow font-bold text-ptc-blue mb-6 not-prose"
                    >
                        {introTitle}
                    </h2>
                    <div
                        class="text-lg leading-relaxed text-gray-600 mb-8"
                        set:html={introText}
                    />

                    <div class="flex flex-col sm:flex-row gap-6 mt-8 not-prose">
                        {
                            introSubPoints.map((point) => {
                                const Icon = point.icon;
                                return (
                                    <div class="flex items-center gap-3">
                                        <div class="p-2 bg-ptc-green/10 rounded-lg shrink-0">
                                            <Icon class="w-5 h-5 text-ptc-green" />
                                        </div>
                                        <span class="font-bold text-gray-900 leading-tight">
                                            {point.text}
                                        </span>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </Section>
    </main>

    <Footer />
</Layout>
