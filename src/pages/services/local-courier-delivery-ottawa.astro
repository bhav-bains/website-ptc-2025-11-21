---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import {
    Package,
    Zap,
    Clock,
    Calendar,
    MapPin,
    MessageCircle,
    Shield,
    Monitor,
    Users,
} from "lucide-react";

const heroTitle = "Ottawa's Fastest Same-Day Courier Delivery Service.";
const heroSubtitle =
    "Get urgent documents, small parcels, and critical items delivered across the National Capital Region quickly, reliably, and with the Personal Touch.";
const heroImage =
    "https://images.pexels.com/photos/4246120/pexels-photo-4246120.jpeg?auto=compress&cs=tinysrgb&w=1600";
const heroIconText = "Local Courier Service";

const breadcrumbs = [
    { name: "Home", url: "/" },
    { name: "Services", url: "/services" },
    {
        name: "Local Courier Delivery Ottawa",
        url: "/services/local-courier-delivery-ottawa",
    },
];

const serviceOptionsTitle = "Our Local Delivery Service Options";
const serviceOptionsDescription =
    "We offer flexible service levels to match your urgency and budget.";

const serviceOptions = [
    {
        icon: Zap,
        title: "Direct/Rush Service",
        description:
            "Your most urgent delivery. Picked up and transported directly to the destination with no stops in between. This is the fastest possible option for mission-critical items.",
        bgColor: "bg-red-500/10",
        iconColor: "text-red-500",
        badge: "FASTEST",
        badgeColor: "bg-red-500",
        image: "https://images.pexels.com/photos/4391470/pexels-photo-4391470.jpeg?auto=compress&cs=tinysrgb&w=800",
    },
    {
        icon: Clock,
        title: "Same-Day Delivery",
        description:
            "The most popular choice for general business needs. Book before our daily cut-off time and your parcel is guaranteed to arrive at its destination before the end of the business day.",
        bgColor: "bg-ptc-green/10",
        iconColor: "text-ptc-green",
        badge: "POPULAR",
        badgeColor: "bg-ptc-green",
        image: "https://images.pexels.com/photos/6169668/pexels-photo-6169668.jpeg?auto=compress&cs=tinysrgb&w=800",
    },
    {
        icon: Calendar,
        title: "Scheduled/Next-Day",
        description:
            "For routine daily or weekly deliveries that require consistency and cost-efficiency. Perfect for inter-office mail or predictable client drops.",
        bgColor: "bg-blue-500/10",
        iconColor: "text-blue-500",
        badge: "COST-EFFICIENT",
        badgeColor: "bg-blue-500",
        image: "https://images.pexels.com/photos/7844005/pexels-photo-7844005.jpeg?auto=compress&cs=tinysrgb&w=800",
    },
];

const featuresTitle =
    "Why Choose Personal Touch Courier for Local Courier Delivery";
const featuresDescription =
    "Our service is built on a promise of reliability, professionalism, and personal attention.";

const features = [
    {
        icon: MapPin,
        title: "Local Expertise, Guaranteed Speed",
        description:
            "Our drivers are local experts. We know the fastest routes around Parliament Hill, the Glebe, and Kanata, ensuring we beat city traffic to get your items there on time. This local knowledge ensures efficiency.",
    },
    {
        icon: MessageCircle,
        title: "Real Communication",
        description:
            "You deal with real people, not automated menus. We provide real-time updates and seamless communication with our local dispatch team from pickup to drop-off.",
    },
    {
        icon: Shield,
        title: "One-Stop Accountability",
        description:
            "Unlike large national carriers, we handle your package with a single chain of custody. You get full attention and reliable service without the complex logistics layers.",
    },
    {
        icon: Monitor,
        title: "Simple Online Access",
        description:
            "Book, track, and manage all your urgent same-day courier needs instantly through our simple online platform.",
    },
    {
        icon: Users,
        title: "Dependable, Courteous Drivers",
        description:
            "Every Personal Touch Courier professional is neat, courteous, and dependable, taking pride in representing your business with professionalism.",
    },
];

const introImage =
    "https://images.pexels.com/photos/6169033/pexels-photo-6169033.jpeg?auto=compress&cs=tinysrgb&w=800";
const introTitle = "When Time is Critical, Trust is Non-Negotiable";
const introText =
    "At Personal Touch Courier, we understand that for professional services, an urgent delivery isn't just about speed—it's about absolute security and compliance. Our Local Courier Delivery is the specialized solution for Ottawa businesses, ensuring your most sensitive documents and time-critical parcels are handled with the discretion and professionalism your firm demands.";

const introSubPoints = [
    { icon: Shield, text: "Mission-Critical Compliance" },
    { icon: Zap, text: "Dedicated Urgency" },
    { icon: Users, text: "Local Team, Single Chain of Custody" },
];
---

<ServiceLayout
    title="Same-Day Courier Delivery Ottawa | Personal Touch Courier"
    description="Need an urgent delivery in Ottawa? Our Local Courier Delivery service offers guaranteed same-day and rush options for parcels and documents. Fast, reliable, and always handled with care."
    heroImage={heroImage}
    heroTitle={heroTitle}
    heroSubtitle={heroSubtitle}
    heroIcon={Package}
    heroIconText={heroIconText}
    breadcrumbs={breadcrumbs}
    serviceOptionsTitle={serviceOptionsTitle}
    serviceOptionsDescription={serviceOptionsDescription}
    serviceOptions={serviceOptions}
    featuresTitle={featuresTitle}
    featuresDescription={featuresDescription}
    features={features}
    introImage={introImage}
    introTitle={introTitle}
    introText={introText}
    introSubPoints={introSubPoints}
/>
