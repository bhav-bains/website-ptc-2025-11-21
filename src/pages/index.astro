---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustedBy from '../components/TrustedBy.astro';
import WhyChoose from '../components/WhyChoose.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import Promise from '../components/Promise.astro';
import LocalExpertise from '../components/LocalExpertise.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Personal Touch Courier | Ottawa's Trusted Courier & Freight Delivery Service"
  description="Personal Touch Courier provides reliable local courier, freight delivery, and dedicated transportation services in Ottawa. Professional, fast, and personalized logistics solutions for your business."
>
  <div class="min-h-screen">
    <Header />
    <main>
      <Hero />
      <TrustedBy />
      <WhyChoose />
      <Services />
      <Gallery />
      <Promise />
      <LocalExpertise />
      <ContactCTA />
    </main>
    <Footer />
  </div>
</Layout>
