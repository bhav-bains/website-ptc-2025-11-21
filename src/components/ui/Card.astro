---
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className, hover = true } = Astro.props;

const baseStyles = 'bg-white rounded-ptc-lg border border-gray-100 p-6 sm:p-8 transition-all duration-300';
const hoverStyles = hover ? 'hover:shadow-ptc-lg hover:-translate-y-1' : '';

const styles = `${baseStyles} ${hoverStyles} shadow-ptc ${className || ''}`;
---

<div class={styles}>
  <slot />
</div>
