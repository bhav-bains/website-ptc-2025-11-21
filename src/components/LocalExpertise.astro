---
---

<section class="bg-ptc-beige section-padding">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-barlow font-bold text-ptc-green mb-6">
          Ottawa's Courier Experts — Born and Built Here.
        </h2>
        <div class="space-y-4 text-lg text-gray-700 leading-relaxed">
          <p>
            We're not just another delivery company. We're your neighbours, your partners, and
            your logistics team — built right here in Ottawa.
          </p>
          <p>
            Our drivers know the streets, our clients know our names, and our service speaks
            for itself.
          </p>
          <p class="text-ptc-teal font-semibold text-xl">
            Proudly Canadian. Proudly local.
          </p>
        </div>
      </div>

      <div class="relative">
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2 relative rounded-ptc overflow-hidden shadow-ptc-lg group">
            <img
              src="https://images.pexels.com/photos/6992/forest-trees-northwestisbest-exploress.jpg?auto=compress&cs=tinysrgb&w=800"
              alt="Parliament Hill Ottawa"
              class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ptc-green/80 to-transparent flex items-end">
              <div class="p-6">
                <p class="text-white font-barlow font-bold text-2xl">Serving Ottawa</p>
              </div>
            </div>
          </div>
          <div class="relative rounded-ptc overflow-hidden shadow-ptc group">
            <img
              src="https://images.pexels.com/photos/1719648/pexels-photo-1719648.jpeg?auto=compress&cs=tinysrgb&w=600"
              alt="Delivery Van"
              class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-ptc-green/20"></div>
          </div>
          <div class="relative rounded-ptc overflow-hidden shadow-ptc group">
            <img
              src="https://images.pexels.com/photos/4246119/pexels-photo-4246119.jpeg?auto=compress&cs=tinysrgb&w=600"
              alt="Professional Courier Service"
              class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-ptc-teal/20"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
