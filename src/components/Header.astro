---
import { Menu, X } from 'lucide-react';
import Button from './ui/Button.astro';
---

<header class="absolute top-0 left-0 w-full z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20 sm:h-24">
      <!-- Logo -->
      <div class="flex items-center">
        <a href="/" class="flex items-center gap-2 group">
          <img
            src="/Logo - Personal Touch Courier.png"
            alt="Personal Touch Courier"
            class="h-10 w-auto brightness-0 invert"
          />
          <span class="text-white font-barlow font-bold text-xl tracking-tight">Personal Touch Courier</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-8 absolute left-1/2 transform -translate-x-1/2">
        <a href="/services" class="text-sm font-medium text-gray-200 hover:text-white transition-colors">Services</a>
        <a href="/pricing" class="text-sm font-medium text-gray-200 hover:text-white transition-colors">Pricing</a>
        <a href="/about" class="text-sm font-medium text-gray-200 hover:text-white transition-colors">About Us</a>
        <a href="/contact" class="text-sm font-medium text-gray-200 hover:text-white transition-colors">Contact</a>
      </nav>

      <!-- Desktop Actions -->
      <div class="hidden md:flex items-center space-x-3">
        <Button 
          href="https://login.dispatchscience.com" 
          target="_blank"
          variant="glass"
          size="sm"
          class="font-bold"
        >
          Login
        </Button>
        <Button 
          href="#signup" 
          variant="primary"
          size="sm"
          class="font-bold text-gray-900"
        >
          Sign Up
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const menuOpen = document.getElementById('menu-open');
  const menuClose = document.getElementById('menu-close');
  const menuLinks = document.querySelectorAll('.mobile-menu-link');

  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menuOpen?.classList.toggle('hidden');
    menuClose?.classList.toggle('hidden');
  });

  menuLinks.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      menuOpen?.classList.remove('hidden');
      menuClose?.classList.add('hidden');
    });
  });
</script>
