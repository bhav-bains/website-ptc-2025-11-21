---
import {
  Phone,
  Mail,
  MapPin,
  Facebook,
  Linkedin,
  Instagram,
} from "lucide-react";
import Section from "./ui/Section.astro";
import Button from "./ui/Button.astro";
---

<Section container={false} class="relative py-24 overflow-hidden">
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-black/60 z-10"></div>
    <div class="absolute inset-0 backdrop-blur-sm z-10"></div>
    <img
      src="/hero-bg.png"
      alt="Personal Touch Courier Delivery Van"
      class="w-full h-full object-cover scale-105 blur-[2px]"
    />
  </div>

  <div class="relative z-20 max-w-4xl mx-auto px-4 text-center">
    <h2 class="text-4xl sm:text-5xl font-barlow font-bold text-white mb-6">
      Ready to explore your possibilities with Personal Touch?
    </h2>
    <p class="text-xl text-blue-100 mb-10 max-w-2xl mx-auto leading-relaxed">
      Same-day courier, local freight, and dedicated routes - made simple, fast,
      and reliable.
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <Button href="#contact" variant="white" size="lg">
        Request a Quote
      </Button>
      <Button
        href="tel:613-723-5891"
        variant="outline"
        size="lg"
        class="border-white text-white hover:bg-white/10"
      >
        <Phone class="w-5 h-5 mr-2" /> Contact Our Team
      </Button>
      <Button
        href="https://personaltouchcourier.dsapp.io/Account/Login"
        target="_blank"
        variant="outline"
        size="lg"
        class="border-white text-white hover:bg-white hover:text-ptc-blue"
      >
        Account Login
      </Button>
    </div>
  </div>
</Section>

<footer class="bg-ptc-green text-white pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand Column -->
      <div>
        <a href="/">
          <img
            src="/ptc-logo.png"
            alt="Personal Touch Courier"
            class="h-16 w-auto mb-6"
          />
        </a>
        <p class="text-ptc-green-100 mb-6 font-medium text-lg">
          Customer-Focused.
        </p>
        <div class="flex space-x-4">
          <a
            href="#"
            class="text-white hover:text-ptc-teal-light transition-colors"
          >
            <Facebook class="w-6 h-6" />
            <span class="sr-only">Facebook</span>
          </a>
          <a
            href="#"
            class="text-white hover:text-ptc-teal-light transition-colors"
          >
            <Linkedin class="w-6 h-6" />
            <span class="sr-only">LinkedIn</span>
          </a>
          <a
            href="#"
            class="text-white hover:text-ptc-teal-light transition-colors"
          >
            <Instagram class="w-6 h-6" />
            <span class="sr-only">Instagram</span>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-barlow font-bold mb-6 text-white">
          Quick Links
        </h3>
        <ul class="space-y-4">
          <li>
            <a
              href="/"
              class="text-ptc-green-100 hover:text-white transition-colors flex items-center gap-2"
            >
              Home
            </a>
          </li>
          <li>
            <a
              href="/about"
              class="text-ptc-green-100 hover:text-white transition-colors flex items-center gap-2"
            >
              About
            </a>
          </li>
          <li>
            <a
              href="/services"
              class="text-ptc-green-100 hover:text-white transition-colors flex items-center gap-2"
            >
              Services
            </a>
          </li>
          <li>
            <a
              href="/blog"
              class="text-ptc-green-100 hover:text-white transition-colors flex items-center gap-2"
            >
              Blog
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="text-ptc-green-100 hover:text-white transition-colors flex items-center gap-2"
            >
              Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-lg font-barlow font-bold mb-6 text-white">
          Our Services
        </h3>
        <ul class="space-y-4">
          <li>
            <a
              href="/services/local-courier-delivery-ottawa"
              class="text-ptc-green-100 hover:text-white transition-colors"
            >
              Local Courier Delivery
            </a>
          </li>
          <li>
            <a
              href="/services/local-freight-delivery-ottawa"
              class="text-ptc-green-100 hover:text-white transition-colors"
            >
              Local Freight Delivery
            </a>
          </li>
          <li>
            <a
              href="/services/dedicated-transportation-ottawa"
              class="text-ptc-green-100 hover:text-white transition-colors"
            >
              Dedicated Transportation
            </a>
          </li>
          <li>
            <a
              href="/services/white-glove-logistics-ottawa"
              class="text-ptc-green-100 hover:text-white transition-colors"
            >
              White Glove Logistics
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-lg font-barlow font-bold mb-6 text-white">
          Contact Us
        </h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3 text-ptc-green-100">
            <MapPin class="w-5 h-5 text-ptc-teal-light flex-shrink-0 mt-1" />
            <span>Ottawa, Ontario</span>
          </li>
          <li>
            <a
              href="tel:613-723-5891"
              class="flex items-center gap-3 text-ptc-green-100 hover:text-white transition-colors"
            >
              <Phone class="w-5 h-5 text-ptc-teal-light flex-shrink-0" />
              <span>(613) 723-5891</span>
            </a>
          </li>
          <li>
            <a
              href="mailto:ops@personaltouchcourier.com"
              class="flex items-center gap-3 text-ptc-green-100 hover:text-white transition-colors"
            >
              <Mail class="w-5 h-5 text-ptc-teal-light flex-shrink-0" />
              <span>ops@personaltouchcourier.com</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-t border-ptc-green-light/30 pt-8 text-center text-ptc-green-100 text-sm"
    >
      <p>
        &copy; {new Date().getFullYear()} Personal Touch Courier. All rights reserved.
      </p>
    </div>
  </div>
</footer>
