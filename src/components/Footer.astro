---
import { Phone, Mail, MapPin, Facebook, Linkedin, Instagram } from 'lucide-react';
---

<footer class="bg-ptc-green text-white pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand Column -->
      <div>
        <a href="/">
          <img
            src="/ptc-logo.png"
            alt="Personal Touch Courier"
            class="h-16 w-auto mb-6"
          />
        </a>
        <p class="text-ptc-green-100 mb-6 font-medium text-lg">
          Canadian-First. Customer-Focused.
        </p>
        <div class="flex space-x-4">
          <a href="#" class="text-white hover:text-ptc-teal-light transition-colors">
            <Facebook class="w-6 h-6" />
            <span class="sr-only">Facebook</span>
          </a>
          <a href="#" class="text-white hover:text-ptc-teal-light transition-colors">
            <Linkedin class="w-6 h-6" />
            <span class="sr-only">LinkedIn</span>
          </a>
          <a href="#" class="text-white hover:text-ptc-teal-light transition-colors">
            <Instagram class="w-6 h-6" />
            <span class="sr-only">Instagram</span>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-barlow font-bold mb-6 text-white">Quick Links</h3>
        <ul class="space-y-4">
          <li>
            <a href="/" class="text-ptc-green-100 hover:text-white transition-colors flex items-center gap-2">
              Home
            </a>
          </li>
          <li>
            <a href="/about" class="text-ptc-green-100 hover:text-white transition-colors flex items-center gap-2">
              About
            </a>
          </li>
          <li>
            <a href="/services" class="text-ptc-green-100 hover:text-white transition-colors flex items-center gap-2">
              Services
            </a>
          </li>
          <li>
            <a href="/blog" class="text-ptc-green-100 hover:text-white transition-colors flex items-center gap-2">
              Blog
            </a>
          </li>
          <li>
            <a href="/contact" class="text-ptc-green-100 hover:text-white transition-colors flex items-center gap-2">
              Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-lg font-barlow font-bold mb-6 text-white">Our Services</h3>
        <ul class="space-y-4">
          <li>
            <a href="/services/local-courier-delivery-ottawa" class="text-ptc-green-100 hover:text-white transition-colors">
              Local Courier Delivery
            </a>
          </li>
          <li>
            <a href="/services/local-freight-delivery-ottawa" class="text-ptc-green-100 hover:text-white transition-colors">
              Local Freight Delivery
            </a>
          </li>
          <li>
            <a href="/services/dedicated-transportation-ottawa" class="text-ptc-green-100 hover:text-white transition-colors">
              Dedicated Transportation
            </a>
          </li>
          <li>
            <a href="/services/white-glove-logistics-ottawa" class="text-ptc-green-100 hover:text-white transition-colors">
              White Glove Logistics
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-lg font-barlow font-bold mb-6 text-white">Contact Us</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3 text-ptc-green-100">
            <MapPin class="w-5 h-5 text-ptc-teal-light flex-shrink-0 mt-1" />
            <span>Ottawa, Ontario</span>
          </li>
          <li>
            <a href="tel:613-723-5891" class="flex items-center gap-3 text-ptc-green-100 hover:text-white transition-colors">
              <Phone class="w-5 h-5 text-ptc-teal-light flex-shrink-0" />
              <span>(613) 723-5891</span>
            </a>
          </li>
          <li>
            <a href="mailto:ops@personaltouchcourier.com" class="flex items-center gap-3 text-ptc-green-100 hover:text-white transition-colors">
              <Mail class="w-5 h-5 text-ptc-teal-light flex-shrink-0" />
              <span>ops@personaltouchcourier.com</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-ptc-green-light/30 pt-8 text-center text-ptc-green-100 text-sm">
      <p>&copy; {new Date().getFullYear()} Personal Touch Courier. All rights reserved.</p>
    </div>
  </div>
</footer>
