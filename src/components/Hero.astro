---
import { ArrowRight } from 'lucide-react';
---

<section id="home" class="relative min-h-[600px] lg:min-h-[700px] flex items-center bg-ptc-beige">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-16 lg:py-24">
    <div
      class="relative rounded-2xl overflow-hidden shadow-ptc-lg"
      style={{
        backgroundImage: 'url("/screen%20copy.png")',
        backgroundSize: 'cover',
        backgroundPosition: 'center',
      }}
    >
      <div class="bg-gradient-to-r from-gray-900/80 via-gray-900/70 to-gray-900/50 px-6 sm:px-12 lg:px-20 py-20 sm:py-28 lg:py-36">
        <div class="max-w-3xl">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-barlow font-bold text-white mb-6 leading-[1.1]">
            Local Courier.<br />
            <span class="text-ptc-beige">Personal Touch.</span>
          </h1>

          <p class="text-lg sm:text-xl lg:text-2xl text-white/95 mb-10 leading-relaxed-extra max-w-2xl">
            Your reliable partner for fast, secure, and personalized delivery services across Ottawa. Same-day courier, freight delivery, and dedicated transportation.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="#contact"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-ptc-green text-white rounded-ptc font-barlow font-semibold text-lg hover:bg-ptc-green-dark transition-all shadow-lg hover:shadow-xl hover:scale-105 transform"
            >
              Request a Quote
              <ArrowRight size={20} />
            </a>
            <a
              href="#services"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 backdrop-blur-sm border-2 border-white text-white rounded-ptc font-barlow font-semibold text-lg hover:bg-white hover:text-ptc-green transition-all"
            >
              Our Services
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
