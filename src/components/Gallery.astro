---
const galleryImages = [
  {
    src: 'https://images.pexels.com/photos/1719648/pexels-photo-1719648.jpeg?auto=compress&cs=tinysrgb&w=800',
    alt: 'Delivery van on the road',
    category: 'Fleet'
  },
  {
    src: 'https://images.pexels.com/photos/6169668/pexels-photo-6169668.jpeg?auto=compress&cs=tinysrgb&w=800',
    alt: 'Team member preparing delivery',
    category: 'Team'
  },
  {
    src: 'https://images.pexels.com/photos/4246120/pexels-photo-4246120.jpeg?auto=compress&cs=tinysrgb&w=800',
    alt: 'Courier delivering packages',
    category: 'Service'
  },
  {
    src: 'https://images.pexels.com/photos/4391470/pexels-photo-4391470.jpeg?auto=compress&cs=tinysrgb&w=800',
    alt: 'Logistics and route planning',
    category: 'Operations'
  },
  {
    src: 'https://images.pexels.com/photos/4246119/pexels-photo-4246119.jpeg?auto=compress&cs=tinysrgb&w=800',
    alt: 'Professional package handling',
    category: 'Service'
  },
  {
    src: 'https://images.pexels.com/photos/1427107/pexels-photo-1427107.jpeg?auto=compress&cs=tinysrgb&w=800',
    alt: 'Freight delivery truck',
    category: 'Fleet'
  },
  {
    src: 'https://images.pexels.com/photos/5025639/pexels-photo-5025639.jpeg?auto=compress&cs=tinysrgb&w=800',
    alt: 'Team collaboration and planning',
    category: 'Team'
  },
  {
    src: 'https://images.pexels.com/photos/4246106/pexels-photo-4246106.jpeg?auto=compress&cs=tinysrgb&w=800',
    alt: 'White glove delivery service',
    category: 'Service'
  },
];
---

<section class="bg-white section-padding">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-barlow font-bold text-ptc-green mb-6">
        See Us In Action
      </h2>
      <p class="text-base sm:text-lg lg:text-xl text-gray-700 max-w-3xl mx-auto leading-relaxed-extra">
        From our fleet to our team, see what makes Personal Touch Courier Ottawa's trusted delivery partner.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {galleryImages.map((image, index) => (
        <div class={`relative overflow-hidden rounded-ptc shadow-ptc hover:shadow-ptc-lg transition-all duration-300 group ${
          index === 0 || index === 3 ? 'sm:col-span-2 sm:row-span-2' : ''
        }`}>
          <img
            src={image.src}
            alt={image.alt}
            class={`w-full object-cover group-hover:scale-110 transition-transform duration-500 ${
              index === 0 || index === 3 ? 'h-full min-h-[400px]' : 'h-64'
            }`}
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end">
            <div class="p-4 w-full">
              <span class="inline-block px-3 py-1 bg-ptc-green text-white text-sm font-barlow font-semibold rounded-full">
                {image.category}
              </span>
              <p class="text-white mt-2 text-sm">{image.alt}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <p class="text-gray-600 text-lg mb-4">
        Want to see more? Follow us on social media for updates and behind-the-scenes content.
      </p>
      <div class="flex justify-center gap-4">
        <a
          href="#"
          class="px-6 py-3 bg-ptc-beige text-ptc-green rounded-ptc font-barlow font-semibold hover:bg-ptc-green hover:text-white transition-colors"
        >
          Follow on Facebook
        </a>
        <a
          href="#"
          class="px-6 py-3 bg-ptc-beige text-ptc-green rounded-ptc font-barlow font-semibold hover:bg-ptc-green hover:text-white transition-colors"
        >
          Follow on Instagram
        </a>
      </div>
    </div>
  </div>
</section>
