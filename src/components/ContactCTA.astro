---
import { Phone, Mail } from 'lucide-react';
---

<section id="contact" class="bg-white section-padding">
  <div class="max-w-5xl mx-auto text-center">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-barlow font-bold text-ptc-green mb-8">
      Ready to Move with a Personal Touch?
    </h2>
    <p class="text-lg sm:text-xl lg:text-2xl text-gray-700 mb-12 leading-relaxed-extra max-w-3xl mx-auto">
      Same-day courier, local freight, and dedicated routes — made simple, fast, and reliable.
    </p>

    <div class="flex flex-col sm:flex-row gap-6 justify-center mb-16">
      <a
        href="mailto:ops@personaltouchcourier.com"
        class="inline-block px-10 py-5 bg-ptc-green text-white rounded-ptc font-barlow font-semibold text-lg hover:bg-ptc-green-dark hover:scale-105 transition-all shadow-ptc-lg hover:shadow-ptc"
      >
        Request a Quote
      </a>
      <a
        href="tel:+16137235891"
        class="inline-flex items-center justify-center gap-2 px-10 py-5 bg-transparent border-2 border-ptc-green text-ptc-green rounded-ptc font-barlow font-semibold text-lg hover:bg-ptc-green hover:text-white transition-all"
      >
        <Phone size={22} />
        Call Us
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto">
      <div class="flex items-center justify-center gap-3 text-gray-700">
        <Phone size={24} />
        <span class="text-lg">(613) 723-5891</span>
      </div>
      <div class="flex items-center justify-center gap-3 text-gray-700">
        <Mail size={24} />
        <a href="mailto:ops@personaltouchcourier.com" class="text-lg hover:underline">
          ops@personaltouchcourier.com
        </a>
      </div>
    </div>
  </div>
</section>
