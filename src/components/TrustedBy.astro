---
import { Quote } from 'lucide-react';

const testimonials = [
  {
    name: 'Sarah L.',
    role: 'Small Business Owner',
    time: '2 weeks ago',
    content: 'Personal Touch Courier has been a lifesaver for our small business. They are always on time, professional, and handle our packages with care. The level of service is exceptional and the team really goes above and beyond.',
    avatar: 'https://images.pexels.com/photos/774909/pexels-photo-774909.jpeg?auto=compress&cs=tinysrgb&w=200',
  },
  {
    name: 'Michael Chen',
    role: 'Operations Manager',
    time: '3 weeks ago',
    content: 'Incredibly reliable and the customer service is second to none. It\'s great to work with a local company that truly cares about its clients. Their dedicated transportation service has streamlined our logistics significantly.',
    avatar: 'https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=200',
  },
  {
    name: 'Jennifer Martinez',
    role: 'Healthcare Administrator',
    time: '1 month ago',
    content: 'We needed a courier service that could handle sensitive medical documents with care and speed. Personal Touch exceeded all our expectations. Their white glove service is truly premium.',
    avatar: 'https://images.pexels.com/photos/1239291/pexels-photo-1239291.jpeg?auto=compress&cs=tinysrgb&w=200',
  },
];
---

<section class="bg-ptc-beige section-padding">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-barlow font-bold text-ptc-green mb-6">
        What Our Clients Say
      </h2>
      <p class="text-base sm:text-lg lg:text-xl text-gray-700 max-w-3xl mx-auto leading-relaxed-extra">
        Don't just take our word for it — hear from the businesses that trust us with their deliveries.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {testimonials.map((testimonial) => (
        <div class="p-8 bg-white rounded-ptc shadow-ptc hover:shadow-ptc-lg transition-all duration-300 relative">
          <Quote class="text-ptc-green/20 w-12 h-12 mb-4" strokeWidth={2} />
          <div class="flex mb-3">
            {[...Array(5)].map(() => (
              <span class="text-yellow-400 text-lg">★</span>
            ))}
          </div>
          <p class="text-gray-700 leading-relaxed-extra mb-6 text-base">
            "{testimonial.content}"
          </p>
          <div class="border-t border-gray-200 pt-4 flex items-center gap-4">
            <img
              src={testimonial.avatar}
              alt={testimonial.name}
              class="w-12 h-12 rounded-full object-cover border-2 border-ptc-green/20"
              loading="lazy"
            />
            <div>
              <div class="font-barlow font-semibold text-gray-900">{testimonial.name}</div>
              <div class="text-sm text-ptc-green">{testimonial.role}</div>
              <div class="text-xs text-gray-500 mt-1">{testimonial.time}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
